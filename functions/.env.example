# Copiá este archivo a ".env" (mismo directorio) y completá los valores.
# ".env" NO se sube a git (ver .gitignore en la raíz del repo).
#
# Estas variables las usa scripts/run-due-task-check.js. En producción NO
# vienen de este archivo — las inyecta el workflow de GitHub Actions
# (.github/workflows/send-due-pushes.yml) desde los Secrets del repo. Este
# .env es solo para poder correr el script a mano en tu máquina.
#
# Generar el par de llaves VAPID: npx web-push generate-vapid-keys
# La llave pública debe coincidir EXACTAMENTE con VITE_VAPID_PUBLIC_KEY en
# client/.env — son un par, no dos llaves independientes.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:tu-correo@ejemplo.com
APP_TIMEZONE=America/Mexico_City

# JSON completo (una sola línea) de una llave de cuenta de servicio de
# Firebase: Firebase Console > ⚙️ Configuración del proyecto > Cuentas de
# servicio > Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT_JSON=
