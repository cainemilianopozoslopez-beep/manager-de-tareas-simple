# Copiá este archivo a ".env" (mismo directorio) y completá los valores con los
# datos de TU proyecto de Firebase: Configuración del proyecto (ícono de engranaje)
# > Tus apps > app web > "Configuración del SDK".
#
# El archivo ".env" NO se sube a git (ver .gitignore) — cada quien usa su propio
# proyecto de Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push VAPID public key (generate with `npx web-push generate-vapid-keys`;
# the matching private key goes in functions/.env, never here).
VITE_VAPID_PUBLIC_KEY=
