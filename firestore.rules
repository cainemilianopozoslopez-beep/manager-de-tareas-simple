// Reglas de seguridad de Firestore para Gmail Task Manager.
//
// Cómo usarlas: en la consola de Firebase, entrá a tu proyecto > Firestore
// Database > pestaña "Reglas", borrá lo que haya y pegá este archivo completo.
// Después hacé clic en "Publicar".
//
// Qué hacen: cada usuario solo puede leer y escribir dentro de su propia
// carpeta (users/{su-uid}/...) — nunca puede ver ni tocar los datos de otro
// usuario, y nadie puede leer/escribir nada sin haber iniciado sesión.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo que cuelga de users/{userId} (tareas, ajustes, etc.) solo es
    // accesible para ese mismo usuario autenticado.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
